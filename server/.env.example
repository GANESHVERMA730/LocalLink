# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://user:pass@cluster.../locallink?retryWrites=true&w=majority

# Long random string used to sign JWTs — change this before deploying
JWT_SECRET=change_this_to_a_long_random_string

# Port the Express server listens on
PORT=5000

# Full URL of the deployed frontend (used for CORS and password reset links)
CLIENT_URL=http://localhost:5173

# Set to true to return the reset URL in the forgot-password API response (dev only).
# MUST be false or unset in production — never expose tokens in API responses.
ENABLE_DEV_RESET_LINK=true

# User-Agent string sent to Nominatim geocoding API (required by OSM usage policy)
GEOCODE_USER_AGENT=LocalLink/1.0 (your-email@example.com)

# Optional: production email provider credentials (leave blank to use Ethereal test emails in dev)
EMAIL_USER=
EMAIL_PASS=
